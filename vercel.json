{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "functions": {
    "api/**/*.py": {
      "includeFiles": [
        "*.py",
        "api/**",
        "templates/**",
        "static/**",
        "public/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/((?!static/|api/health).*)",
      "destination": "/api/index.py"
    }
  ]
}
