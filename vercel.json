{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "{templates/**,static/**,public/**}",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/((?!static/).*)",
      "destination": "/api/index.py"
    }
  ]
}
